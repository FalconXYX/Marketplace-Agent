# Marketplace Agent secrets and common settings. Copy to .env (git ignored) and fill in.
# Priority: environment > .env > marketplace_agent.toml > defaults.
# Uncomment a line only to give it a value: an empty number is an error.
# Lists and tables (hours, caps, limits) are easier in the TOML file.

# ---- Models
# Free key: https://aistudio.google.com/apikey. The only provider with vision (photo drafting).
# MA_GEMINI_API_KEY also works.
GEMINI_API_KEY=
# Optional text-only fallbacks when Gemini's daily quota runs out (MA_ prefix also works).
# GROQ_API_KEY=            # https://console.groq.com/keys
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys
# MA_REASONING_MODEL=gemini-flash-latest
# MA_VISION_MODEL=gemini-flash-latest
# MA_CHEAP_MODEL=gemini-3.5-flash-lite

# ---- Seller
# Exact address. Sent to a buyer only after a deal is agreed, a pickup is booked, and your
# undo window has passed. Never in prompts, logs, or listings.
# MA_PICKUP_ADDRESS=
# Cross street, safe to share with anyone.
# MA_PICKUP_AREA=
# MA_TIMEZONE=America/Toronto
# JSON list: kijiji, facebook, fake.
# MA_ENABLED_PLATFORMS=["kijiji"]

# ---- Kijiji (unofficial API; see README)
# MA_KIJIJI_EMAIL=
# MA_KIJIJI_PASSWORD=
# MA_KIJIJI_LOCATION_ID=
# MA_KIJIJI_POSTAL_CODE=

# ---- Discord (see README for the bot setup)
# MA_DISCORD_TOKEN=
# MA_DISCORD_CHANNEL_ID=
# MA_DISCORD_OWNER_ID=
# MA_DISCORD_DIGEST_HOUR=20

# ---- Facebook (optional extra; no password stored, you log in once in the browser)
# MA_FACEBOOK_HEADLESS=false
# MA_FACEBOOK_PROFILE_DIR=data/facebook_profile

# ---- Web intake
# Long random string, e.g. from `openssl rand -hex 24`. When set, open the UI once with
# ?token=<value>; the browser keeps a cookie after that.
# MA_WEB_TOKEN=
# MA_WEB_HOST=127.0.0.1
# MA_WEB_PORT=8765

# ---- Storage
# MA_DATA_DIR=data
# MA_DB_URL=sqlite:///data/agent.db
